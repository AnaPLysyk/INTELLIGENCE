# Configure os valores abaixo no .env.local. Em CI, injete as mesmas variaveis como secrets.

# Overrides opcionais; por padrao estes valores sao herdados do ambiente SMART.
INTELLIGENCE_UI_URL=
INTELLIGENCE_API_URL=
INTELLIGENCE_ADMIN_USERNAME=
INTELLIGENCE_ADMIN_PASSWORD=

# Templates genericos de deep-link. Os INT_100_* continuam aceitos por compatibilidade.
INTELLIGENCE_TRANSACAO_URL_TEMPLATE={base}/transaction/{tguid}
INTELLIGENCE_PERFIL_URL_TEMPLATE={base}/person/{pguid}

# Overrides opcionais. Sem eles, o setup classifica as contas tecnicas do SMART pelos claims JWT.
INT_100_VIEWONLY_USERNAME=
INT_100_VIEWONLY_PASSWORD=
INT_100_SEM_PERMISSAO_USERNAME=
INT_100_SEM_PERMISSAO_PASSWORD=

# Overrides opcionais da massa; quando vazios, TGUID/PGUID sao gerados pelo SMART.
INT_100_TGUID=
INT_100_PGUID=
INT_100_TRANSACAO_URL_TEMPLATE={base}/transaction/{tguid}
INT_100_PERFIL_URL_TEMPLATE={base}/person/{pguid}

# Massas especificas para cobertura historica. Deixe vazias quando nao houver uma massa comprovada;
# o caso sera classificado como BLOQUEADO em vez de inventar dados.
INT_31_TGUID=
INT_31_KEY_FIELD_LABEL=
INT_31_BIOGRAPHIC_FIELD_LABEL=
INT_32_TGUID=
INT_32_DATE_FIELD_LABEL=
INT_40_TGUID=
INT_40_PGUID=
INT_40_DATE_FIELD_LABEL=
INT_24_PGUID=
INT_24_PREVIOUS_PGUID=
INT_30_TGUID=

# Massa de busca proveniente do SMART (sem INSERT/UPDATE/DELETE)
SMART_API_BASE_URL=
SMART_UI_USERNAME=
SMART_UI_PASSWORD=
SMART_DB_HOST=
SMART_DB_PORT=3306
SMART_DB_NAME=SMART
SMART_DB_USER=
SMART_DB_PASSWORD=
SMART_MASSA_LIMITE_CANDIDATOS=30
SMART_MASSA_CONCORRENCIA=5
INTELLIGENCE_MASSA_TIPOS=PGUID,TGUID,EXTERNAL.ID,cpf,birthdate,name,cib
INTELLIGENCE_MASSA_TIPOS_OBRIGATORIOS=PGUID,TGUID,cpf
INTELLIGENCE_MASSA_FILE=test-data/generated/intelligence.busca.massa.json

# Origem das chaves do perfil que nao existem no banco SMART.
GBDS_API_BASE_URL=
GBDS_USERNAME=
GBDS_PASSWORD=
