{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "config/**/*.ts",
    "cucumber/**/*.ts",
    "steps/**/*.ts",
    "pom/**/*.ts",
    "utils/**/*.ts",
    "scripts/**/*.ts"
  ]
}
