{
  "name": "intelligence-automacao",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validar:estrutura": "node support/playwright/validar-estrutura.cjs",
    "validar": "npm run typecheck && npm run validar:estrutura && node orchestrator.cjs regression --list",
    "massa:smart": "playwright test --config=support/playwright/massa.config.ts",
    "test:list": "node orchestrator.cjs regression --list",
    "test:smoke": "node orchestrator.cjs smoke",
    "test:regression": "node orchestrator.cjs regression",
    "test:destructive": "node orchestrator.cjs destructive",
    "test:release": "node orchestrator.cjs release",
    "test:scheduled": "node orchestrator.cjs --scheduled",
    "test:cucumber": "cucumber-js --config cucumber.cjs",
    "test:cucumber:int100": "cucumber-js --config cucumber.cjs --tags @int-100",
    "test:cucumber:int100:dry": "cucumber-js --config cucumber.cjs --tags @int-100 --dry-run",
    "plan:show": "node orchestrator.cjs --show-plan",
    "report:pdf": "node support/playwright/gerar-relatorio-pdf.cjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@playwright/test": "1.60.0",
    "@types/node": "25.9.1",
    "dotenv": "17.4.2",
    "mysql2": "3.23.0",
    "typescript": "6.0.3"
  }
}
