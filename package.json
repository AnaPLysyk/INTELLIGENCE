{
  "name": "intelligence-automacao",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validar": "npm run typecheck && playwright test --list",
    "massa:smart": "playwright test --config=support/playwright.massa.config.ts",
    "test:list": "playwright test --list",
    "test:intelligence": "playwright test tests/ui tests/api",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:positive": "playwright test tests/ui/intelligence.positivo.ui.spec.ts tests/api/intelligence.positivo.api.spec.ts",
    "test:negative": "playwright test tests/ui/intelligence.negativo.ui.spec.ts tests/api/intelligence.negativo.api.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "25.9.1",
    "dotenv": "17.4.2",
    "mysql2": "3.23.0",
    "typescript": "6.0.3"
  }
}
