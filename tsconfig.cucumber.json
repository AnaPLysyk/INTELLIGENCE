{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".cucumber-dist",
    "rootDir": ".",
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "config/**/*.ts",
    "cucumber/**/*.ts",
    "steps/**/*.ts",
    "pom/**/*.ts",
    "utils/**/*.ts",
    "scripts/**/*.ts"
  ]
}
